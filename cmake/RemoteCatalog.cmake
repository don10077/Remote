# Physical remotes, independently of the optional GUI artwork catalogue.
set(catalogFile "${PROJECT_SOURCE_DIR}/core/resources/remoteCatalog.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${catalogFile}")
file(READ "${catalogFile}" catalog)
string(JSON count LENGTH "${catalog}")
math(EXPR last "${count} - 1")
set(entries "")
foreach(i RANGE ${last})
    foreach(field id name visualProfile)
        string(JSON ${field} GET "${catalog}" ${i} ${field})
    endforeach()
    foreach(field network read write writeTested)
        string(JSON value GET "${catalog}" ${i} ${field})
        if(value)
            set(${field} true)
        else()
            set(${field} false)
        endif()
    endforeach()
    string(JSON skins GET "${catalog}" ${i} skins)
    string(REPLACE "[" "" skins "${skins}")
    string(REPLACE "]" "" skins "${skins}")
    string(REGEX REPLACE "[\n\r ]" "" skins "${skins}")
    string(APPEND entries "RemoteModel{\"${id}\", \"${name}\", {${skins}}, ${network}, ${read}, ${write}, ${writeTested}, \"${visualProfile}\"},\n")
endforeach()
file(WRITE "${PROJECT_BINARY_DIR}/core/generated/harmony/core/remoteCatalog.inc" "${entries}")
