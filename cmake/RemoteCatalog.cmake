# Physical remotes, independently of the optional GUI artwork catalogue.
set(catalogFile "${PROJECT_SOURCE_DIR}/core/resources/remoteCatalog.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${catalogFile}")
file(READ "${catalogFile}" catalog)
string(JSON count LENGTH "${catalog}")
math(EXPR last "${count} - 1")
set(entries "")
foreach(i RANGE ${last})
    # Обязательные поля: без ERROR_VARIABLE, чтобы ошибка была видна при конфигурации.
    foreach(field id name skins)
        string(JSON ${field} GET "${catalog}" ${i} ${field})
    endforeach()
    string(REPLACE "[" "" skins "${skins}")
    string(REPLACE "]" "" skins "${skins}")
    string(REGEX REPLACE "[\n\r ]" "" skins "${skins}")

    # Необязательные поля: нет ключа — значение по умолчанию.
    string(JSON architecture ERROR_VARIABLE architectureError GET "${catalog}" ${i} architecture)
    if(architectureError OR architecture STREQUAL "")
        set(architecture 0)
    endif()
    # Связь: строка каталога → значение перечисления LinkKind.
    string(JSON link ERROR_VARIABLE linkError GET "${catalog}" ${i} link)
    if(linkError OR link STREQUAL "" OR link STREQUAL "none")
        set(linkExpr "LinkKind::None")
    elseif(link STREQUAL "usb-net")
        set(linkExpr "LinkKind::UsbNet")
    elseif(link STREQUAL "usb-hid")
        set(linkExpr "LinkKind::UsbHid")
    elseif(link STREQUAL "mh")
        set(linkExpr "LinkKind::Mh")
    elseif(link STREQUAL "hub")
        set(linkExpr "LinkKind::Hub")
    else()
        message(FATAL_ERROR "remoteCatalog.json: unknown link '${link}' for model ${id}")
    endif()
    foreach(field read rawRestore configWriteTested)
        string(JSON value ERROR_VARIABLE valueError GET "${catalog}" ${i} ${field})
        if(valueError OR NOT value)
            set(${field} false)
        else()
            set(${field} true)
        endif()
    endforeach()

    # Именованная инициализация: порядок полей структуры больше не важен.
    string(APPEND entries
        "RemoteModel{.id = \"${id}\", .name = \"${name}\", .skins = {${skins}}, .architecture = ${architecture}, .link = ${linkExpr}, .readable = ${read}, .rawRestore = ${rawRestore}, .configWriteTested = ${configWriteTested}},\n")
endforeach()
file(WRITE "${PROJECT_BINARY_DIR}/core/generated/harmony/core/remoteCatalog.inc" "${entries}")
